# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram User Numeric ID (from @userinfobot) - Whitelist security protection
ALLOWED_USER_ID=123456789

# Chrome DevTools Protocol (CDP) port for VS Code
CDP_PORT=9222

# Workspace / Project display name in status messages
TARGET_PROJECT_NAME=my_workspace

# Optional: Custom temporary directory for photo uploads (defaults to OS temp directory)
# TEMP_IMAGE_DIR=/path/to/custom/temp/images
